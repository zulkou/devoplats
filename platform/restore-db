#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${LIB_DIR}/lib/constants.sh"
source "${LIB_DIR}/lib/common.sh"
source "${LIB_DIR}/lib/logger.sh"
source "${LIB_DIR}/lib/docker.sh"
source "${LIB_DIR}/lib/restore.sh"

# Guard: must not run from GitHub Actions, and requires an interactive terminal
[[ "${GITHUB_ACTIONS:-}" == "true" ]] && die "restore-db cannot be executed from GitHub Actions"
[[ -t 0 ]] || die "restore-db must be run interactively"

parse_args "$@"

validate_args APP
init_environment
init_logger

[[ -n "$BACKUP_FILE" ]] || die "Usage: devops restore-db --app <app> [--env <env>] --backup <filename>"
backup_path="${BACKUP_DIR}/${BACKUP_FILE}"
[[ -f "$backup_path" ]] || die "Backup file not found: ${backup_path}"

log_warn "!! THIS WILL OVERWRITE THE CURRENT DATABASE FOR ${APP} WITH ${BACKUP_FILE} !!"
log_warn "Any data written after this backup was taken will be LOST."
confirm "Type y to confirm you understand this is destructive and irreversible" || { log_info "Restore cancelled"; exit 0; }

if ! restore_backup_file "$BACKUP_FILE" "$ENGINE"; then
    record_history "restore-db" "$BACKUP_FILE" "failed"
    exit 1
fi

record_history "restore-db" "$BACKUP_FILE" "success"
