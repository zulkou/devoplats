# devoplats site configuration — copy to .env and edit.
# Precedence: shell environment > .env > built-in default.
# .env is gitignored; app secrets live in configs/<app>/.env.

# ── Paths ────────────────────────────────────────────────────────────────
# DEVOPS_ROOT resolves to the clone location (override via shell env only —
# this file is found by walking up from the scripts, so it cannot move itself).
# Runtime dir per app: <APPS_ROOT>/<app>/ holds compose.yml and the generated .env
#APPS_ROOT=/opt/apps
# Derived from DEVOPS_ROOT (override only for unusual layouts):
#CONFIGS_ROOT=
#LOGS_ROOT=
#BACKUPS_ROOT=
#VERSIONS_ROOT=
#HISTORY_ROOT=

# ── Image registry ───────────────────────────────────────────────────────
# Paths are lowercased automatically (GHCR rejects mixed case).
REGISTRY=ghcr.io/example

# ── Secret files ─────────────────────────────────────────────────────────
# Platform config, infra credentials, and backup credentials live in this
# file (mode 600/640). App secrets live beside each app's config:
#   <install-root>/configs/<app>/.env (mode 600)

# ── Infrastructure credentials ───────────────────────────────────────────
GHCR_USERNAME=
GHCR_TOKEN=
ACCESS_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Backup DB credentials, referenced by config.yml backup entries.
# LOCAL-ONLY: keep these in this file (or the shell), never in app env files.
# Key derivation: BACKUP_<APP SLUG UPPER, non-alphanumerics -> "_">
#BACKUP_MYAPP_USER=
#BACKUP_MYAPP_PASS=

# ── Webhook server ───────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=10000
#WEBHOOK_LOG=/opt/devoplats/logs/webhook.log

# ── Ephemeral runners ────────────────────────────────────────────────────
# Public upstream image; override only to pin or use a private image.
#RUNNER_IMAGE=myoung34/github-runner:latest
RUNNER_SCOPE=org
ORG_NAME=your-github-org
#RUNNER_SCOPE=repo
#REPO_URL=https://github.com/your-owner/your-repo
DNS_SERVERS=1.1.1.1,8.8.8.8

# ── Docker target ────────────────────────────────────────────────────────
# Daemon used for app deploys/backups (unset = local daemon).
# See docs/remote-docker.md and verify with ./bin/devops doctor.
#DOCKER_HOST=ssh://devoplats-remote
# Directory with config/docker.pem/known_hosts mounted at /root/.ssh in runners:
#RUNNER_SSH_DIR=/etc/devoplats/ssh
# Image used to probe container-name healthcheck URLs from the app's network:
#HEALTHCHECK_PROBE_IMAGE=curlimages/curl:latest

# ── Platform behavior ────────────────────────────────────────────────────
# Valid values for `devops --env`:
DEPLOY_ENVS=dev prod
# Seconds to wait for a container to become healthy before rolling back:
SERVICE_WAIT_TIMEOUT=60
# `devops doctor` fails when these minimums are not met:
#MIN_DOCKER_VERSION=20.10.0
#MIN_COMPOSE_VERSION=2.6.0
#MIN_FREE_DISK_GB=5
